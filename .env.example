# ==============================================================================
# FinPilot AI — Environment Configuration Template
# Copy this file to .env and configure values appropriate for your environment.
# NEVER commit real credentials, passwords, or production API keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
PROJECT_NAME="FinPilot AI API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Environment: "development" | "test" | "production"
# In production, startup validates that no insecure default keys or placeholders are used.
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# In production: generate a 32+ character random string (e.g., openssl rand -hex 32)
SECRET_KEY=dev_secret_key_CHANGE_ME_in_production_use_32plus_random_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ISSUER=finpilot-ai
JWT_AUDIENCE=finpilot-api

# ------------------------------------------------------------------------------
# 3. RATE LIMITING & SECURITY THRESHOLDS
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_IMPORT_PER_MINUTE=15
RATE_LIMIT_DEFAULT_PER_MINUTE=120
MAX_UPLOAD_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=finpilot_db

# Async connection URL (FastAPI / SQLAlchemy AsyncSession)
DATABASE_URL=postgresql+asyncpg://finpilot:your_secure_db_password_here@localhost:5432/finpilot_db

# Sync connection URL (Alembic database migrations)
SYNC_DATABASE_URL=postgresql://finpilot:your_secure_db_password_here@localhost:5432/finpilot_db

# ------------------------------------------------------------------------------
# 5. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 6. AI & LLM PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Provider: "mock" (offline/tests, deterministic) | "openai" (live GPT models)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500

# Required when LLM_PROVIDER=openai
LLM_API_KEY=

# LangGraph Multi-Agent Engine
MAX_GRAPH_ITERATIONS=5
MAX_TOOL_CALLS_PER_REQUEST=5
MAX_CONVERSATION_HISTORY_MESSAGES=10
MAX_TRANSACTION_SEARCH_LIMIT=20

# ------------------------------------------------------------------------------
# 7. RAG & EMBEDDING CONFIGURATION
# ------------------------------------------------------------------------------
# Provider: "mock" (deterministic hash embeddings) | "openai" (text-embedding-ada-002)
EMBEDDING_PROVIDER=mock
RAG_TOP_K=5

# Optional: LangSmith Tracing & Observability (leave false if not using)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finpilot-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ------------------------------------------------------------------------------
# 8. FRONTEND CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
INTERNAL_API_URL=http://api:8000/api/v1