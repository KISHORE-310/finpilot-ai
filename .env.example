# ==============================================================================
# FinPilot AI — Master Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Database Credentials
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=finpilot_secure_pass_2026
POSTGRES_DB=finpilot_db
POSTGRES_PORT=5432

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_strong_random_secret_in_production_32_bytes_min
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend Database URLs (used by FastAPI app)
DATABASE_URL=postgresql+asyncpg://finpilot:finpilot_secure_pass_2026@localhost:5432/finpilot_db
SYNC_DATABASE_URL=postgresql://finpilot:finpilot_secure_pass_2026@localhost:5432/finpilot_db

# URLs and Ports
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Provider Settings (Optional: defaults to deterministic mock for local development and tests)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500

# Semantic RAG Embeddings (mock or openai)
EMBEDDING_PROVIDER=mock

# LangSmith Tracing & Observability (Optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finpilot-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
