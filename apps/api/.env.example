PROJECT_NAME="FinPilot AI API"
VERSION="1.0.0"
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_strong_random_secret_in_production_32_bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=postgresql+asyncpg://finpilot:finpilot_secure_pass_2026@localhost:5432/finpilot_db
SYNC_DATABASE_URL=postgresql://finpilot:finpilot_secure_pass_2026@localhost:5432/finpilot_db

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500

EMBEDDING_PROVIDER=mock

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finpilot-ai
